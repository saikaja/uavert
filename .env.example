# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Neon connection string (direct host, not "-pooler"), e.g. from the Neon console or `get_connection_string`.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Neon "test" branch, used only by the automated tests. Tests that need it are skipped when unset.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
